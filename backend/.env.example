# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=grunray_wiki

# Markdown 根目录（相对 backend 目录或绝对路径）
CONTENT_ROOT=content

FLASK_DEBUG=1

# 会话签名（生产务必改为随机长字符串）
SECRET_KEY=change-me

# 留言 OAuth：redirect_uri = {OAUTH_PUBLIC_BASE}/api/auth/{github|google}/callback
OAUTH_PUBLIC_BASE=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GitHub OAuth App（Settings → Developer settings → OAuth Apps）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google Cloud Console → OAuth 2.0 Client（Web application）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 留言板
MESSAGE_MIN_LENGTH=2
MESSAGE_MAX_LENGTH=500
MESSAGE_IP_COOLDOWN_SEC=60
MESSAGE_RATE_LIMIT_PER_USER=10
MESSAGE_CAPTCHA_TTL_SEC=300
MESSAGE_AUTO_PUBLISH=false
MESSAGE_OWNER_REPLY_COOLDOWN_SEC=10
MESSAGE_ADMIN_PAGE_SIZE=30
MESSAGE_SENSITIVE_WORDS_PATH=data/sensitive_words.txt
# 站长判定（满足其一即可）：主页 URL / OAuth 用户 ID
MESSAGE_OWNER_PROFILE_URLS=https://github.com/Grunray
MESSAGE_OWNER_GITHUB_IDS=
MESSAGE_OWNER_GOOGLE_IDS=
SITE_OWNER_NAME=GrunRay
SITE_OWNER_AVATAR_URL=/favicon.jpg

# 友链
FRIEND_IP_COOLDOWN_SEC=120
FRIEND_APPLICATION_MAX_PER_IP_PER_DAY=5
FRIEND_CAPTCHA_TTL_SEC=300
FRIEND_AUTO_PUBLISH=false
FRIEND_ADMIN_PAGE_SIZE=30
FRIEND_SENSITIVE_WORDS_ENABLED=true
FRIEND_SPECIAL_LINKS_PATH=data/friend_special_links.json
FRIENDS_SITE_TITLE=GrunRay
FRIENDS_SITE_URL=http://localhost:5173
FRIENDS_SITE_LOGO_URL=
FRIENDS_SITE_DESCRIPTION=个人成果与笔记：项目、开发记录与算法心得。
